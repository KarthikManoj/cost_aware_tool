# ============================================================
# CENTRAL CONFIG - every script sources this file.
# Fill in the CHANGE_ME values before running anything.
# ============================================================

# ---------- Azure ----------
RESOURCE_GROUP="spark-benchmark-rg"
SUBSCRIPTION_ID=""                     # leave blank if you only have one subscription

# ---------- VM login (same for all VMs - fine for non-production) ----------
ADMIN_USERNAME="benchadmin"
ADMIN_PASSWORD="<add new password here>"   # 12+ chars, upper+lower+digit+symbol

# ---------- Regions to test ----------
REGIONS=("centralindia" "southeastasia")

# ---------- VM sizes to test ----------
# D*s_v5 and D*as_v5 REMOVED: your subscription shows 0 quota for the
# DSv5 and DASv5 families in both regions (checked via `az vm list-usage`).
# File a quota increase (Azure Portal -> Quotas) if you want these back,
# then re-add them here once approved.
VM_SIZES=(
  "Standard_D2s_v3"
  "Standard_D4s_v3"
  "Standard_D2as_v4"
  "Standard_D4as_v4"
  "Standard_D2ds_v4"
  "Standard_D4ds_v4"
)

# ---------- Per-family vCPU caps (from `az vm list-usage`) ----------
# Azure quota is per (region, VM family), not a single number per region -
# e.g. southeastasia allows 32 DSv3 vCPUs but only 10 DASv4/DDSv4 vCPUs.
# Keyed "region:family"; family comes from common.sh's vm_family(). Used to
# skip/warn on combos that can't physically fit, e.g. a 4-node D4as_v4
# cluster (16 vCPU) in southeastasia (DASv4 cap 10). Re-check with
# `az vm list-usage --location <region> -o table` after any quota change.
declare -A REGION_FAMILY_VCPU_CAP=(
  ["centralindia:DSv3"]=10
  ["centralindia:DASv4"]=10
  ["centralindia:DDSv4"]=32
  ["southeastasia:DSv3"]=32
  ["southeastasia:DASv4"]=10
  ["southeastasia:DDSv4"]=10
)

# ---------- Spark cluster sizes to test ----------
NODE_COUNTS=(2 4)

# ---------- Azure Storage (permanent home for datasets/jobs/results) ----------
STORAGE_ACCOUNT_NAME="yourstorageaccount"
STORAGE_ACCOUNT_KEY="<add new key here>"  # leave blank if you want to use a SAS token instead
# Actual containers in the account (verified via `az storage container list`) -
# there is no single "benchmark" container, so dataset/script/result storage
# is split across the containers that actually exist.
DATASET_CONTAINER_NAME="datasets"      # events_<size>[mb].csv blobs live here
SCRIPTS_CONTAINER_NAME="scripts"       # cpu_heavy.py/io_heavy.py/memory_heavy.py/common.py/__init__.py
RESULTS_CONTAINER_NAME="datasets"      # results_<hostname>.csv uploaded under results/
# Expected blob layout:
#   datasets container: events_10mb.csv, events_100mb.csv, events_500mb.csv,
#                        events_1024mb.csv, events_2048.csv, events_3072.csv,
#                        events_5120mb.csv, results/results_<hostname>.csv
#   scripts container:  __init__.py, common.py, cpu_heavy.py, io_heavy.py, memory_heavy.py
#                        (downloaded flat into /opt/benchmark/spark_jobs/ as a package)

# ---------- Benchmark matrix ----------
# Must match dataset sizes actually present in the datasets container above.
DATASET_SIZES_MB=(10 100 500 1024 2048 3072 5120)
WORKLOAD_TYPES=("cpu" "memory" "io")     # maps to jobs/{type}_heavy.py in blob
REPETITIONS=2

# ---------- Sequential run settings ----------
# VMs are created per (region, size, node_count) combo, tested, then deleted -
# not all upfront. This fits within the tight southeastasia 10-vCPU cap.
# Seconds to wait/poll for cloud-init to finish installing Spark before use.
INSTALL_POLL_INTERVAL=15
INSTALL_POLL_MAX_TRIES=180  # 180 x 15s = 45 min timeout

# ---------- Spark / Java versions (installed by cloud-init) ----------
SPARK_VERSION="3.5.1"
JAVA_VERSION="17"
